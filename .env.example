# The Localhost Times: every integration switches on when its variables are set.
# Run `uv run localhost-times --list` to see what is on.

# --- You -------------------------------------------------------------------
READER_NAME=Sam

# --- Mail (IMAP, opened read-only: nothing is marked as read) ----------------
# Gmail, iCloud, Fastmail, Yahoo, Zoho, AOL, GMX are detected from the address.
# Use an app password (Gmail: myaccount.google.com/apppasswords, needs 2-step verification).
MAIL_USER=
MAIL_PASSWORD=
# MAIL_HOST=imap.example.com:993      # any other IMAP server over SSL
# SMTP_HOST=smtp.example.com:465      # 465 = SSL, 587 = STARTTLS

# --- Calendars (any iCal link, comma separated) ------------------------------
# Google: Settings > your calendar > "Secret address in iCal format"
# Outlook / Microsoft 365: Settings > Calendar > Shared calendars > Publish > ICS
ICAL_URLS=

# --- Tasks -------------------------------------------------------------------
TODOIST_TOKEN=          # todoist.com > Settings > Integrations > Developer
GITHUB_TOKEN=           # a token with the "notifications" scope

# --- Weather (Open-Meteo, no key) --------------------------------------------
WEATHER_CITY=

# --- News --------------------------------------------------------------------
NEWS_TOPICS=top,technology      # Google News; "top" = the front page
RSS_FEEDS=                      # comma separated RSS/Atom URLs
HACKERNEWS=                     # number of top stories, e.g. 5

# --- The editor (open models) --------------------------------------------------
MODEL=gemma4:e4b
# OLLAMA_URL=http://localhost:11434
# Any OpenAI-compatible server instead of Ollama (LM Studio, llama.cpp, vLLM, Jan):
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=

# --- Voice -------------------------------------------------------------------
# elevenlabs | say (macOS, fully offline) | none. Default: elevenlabs if a key is set, else say on macOS.
# VOICE=say
ELEVENLABS_API_KEY=
# VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Delivery (the edition is always saved to editions/<date>/) ---------------
# Email goes out through the mail account above.
# SEND_TO=friend@example.com
TELEGRAM_BOT_TOKEN=     # from @BotFather; send your bot a message first
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
NTFY_TOPIC=             # pick a long random topic name; the ntfy app subscribes to it
# NTFY_SERVER=https://ntfy.sh
